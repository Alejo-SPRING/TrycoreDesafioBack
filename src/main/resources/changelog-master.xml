<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--Changelogs create-->
    <includeAll path="create" relativeToChangelogFile="true"/>
    <includeAll path="relations" relativeToChangelogFile="true"/>

    <!--Changelogs insert-->
    <includeAll path="insert" relativeToChangelogFile="true"/>
    <!--Changelogs update-->
    <includeAll path="update" relativeToChangelogFile="true"/>

</databaseChangeLog>
